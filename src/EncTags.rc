#include <windows.h>
#include "resource.h"

IDD_PASSWORD_DLG DIALOGEX 0, 0, 260, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EncTags"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Encrypted tags found:", IDC_TAG_COUNT_LABEL, 14, 10, 230, 10
    LTEXT           "Password:", IDC_PASSWORD_LABEL, 14, 30, 40, 10
    EDITTEXT        IDC_PASSWORD_EDIT, 60, 28, 180, 14, ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "LOCAL (password only)", IDC_MODE_LOCAL, "Button", BS_AUTORADIOBUTTON | WS_GROUP, 14, 52, 120, 10
    CONTROL         "OPRF (password + service)", IDC_MODE_OPRF, "Button", BS_AUTORADIOBUTTON, 14, 66, 120, 10
    DEFPUSHBUTTON   "OK", IDOK, 140, 78, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 196, 78, 50, 14
END

IDD_CLOSE_DLG DIALOGEX 0, 0, 260, 110
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "EncTags"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Decrypted blocks found:", IDC_CLOSE_LABEL, 14, 12, 230, 12
    DEFPUSHBUTTON   "1. Encrypt",              IDC_BTN_ENCRYPT, 14, 36, 230, 18
    PUSHBUTTON      "2. Return to document",   IDC_BTN_RETURN,  14, 58, 230, 18
    PUSHBUTTON      "3. No (close as is)",     IDC_BTN_IGNORE,  14, 80, 230, 18
END
